# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Any LiteLLM-style model id works, e.g.
#   anthropic/claude-sonnet-5-5   (default)
#   openai/gpt-4o                 (needs OPENAI_API_KEY)
#   gemini/gemini-2.0-flash       (needs GEMINI_API_KEY)
#   ollama/qwen3.5:4b             (self-hosted Ollama, no API key; see OLLAMA_* below)
#   mock                          (offline demo: no API key, deterministic fake agents)
MODEL=anthropic/claude-sonnet-5-5
TEMPERATURE=0.3
VERBOSE=true
DATA_SOURCE=local

# Ollama (only used when MODEL=ollama/...). Inside Docker use http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window requested per call. Ollama's default (4096) is too small for the prompts.
# OLLAMA_NUM_CTX=16384

# Optional: override the cost estimate (USD per 1M tokens) for models not in the table.
# PRICE_INPUT_PER_MTOK=2.00
# PRICE_OUTPUT_PER_MTOK=10.00

# ---------------------------------------------------------------------------
# Northcart store (FastAPI web app: uv run northcart -> http://127.0.0.1:8000)
# The store's AI features (ShopCrew runs, "Write with AI") use MODEL above.
# For a free local setup:  MODEL=ollama/qwen3.5:4b  (ollama pull qwen3.5:4b)
# ---------------------------------------------------------------------------
# SQLite file (or any SQLAlchemy URL). Created and seeded on first start.
# STORE_DB=store.db
# Set a fixed value so sign-ins survive restarts (any long random string).
# STORE_SECRET_KEY=
# STORE_MEDIA_DIR=media
# FREE_SHIPPING_THRESHOLD=35
# SHIPPING_FEE=5
# COD_FEE=2
# RETURN_WINDOW_DAYS=7

# Demo sign-ins created by the seeder (test values for local use only).
ADMIN_EMAIL=admin@northcart.test
ADMIN_PASSWORD=admin1234
DEMO_CUSTOMER_EMAIL=customer@northcart.test
DEMO_CUSTOMER_PASSWORD=shop1234
